# AI Team configuration. Behaviour lives in configs/*.yaml; this file holds what differs per environment.
#   .env       local development  (docker compose up / docker compose watch)
#   .env.prod  production         (./deploy.sh → swarm stack on the Proxmox docker-vm)
# Comments must be on their own lines (Docker keeps inline "# ..." as part of the value).

# --- Deploy (production only; ignored by docker compose) -----------------------------------------
# Docker context of the swarm manager. One-time: docker context create docker-vm --docker host=ssh://docker-vm
AI_TEAM_DEPLOY_CONTEXT=docker-vm
# Host the dashboard is reached on (default: taken from the context)
AI_TEAM_DEPLOY_HOST=192.168.100.10
# Paths ON THE TARGET HOST: durable data (redis AOF, mongo, logins, skills) and the agents' repos
AI_TEAM_DATA_ROOT=/data/stacks/ai-team/data
# Optional registry: build locally and push (e.g. 192.168.100.10:10400); empty = build on the target
AI_TEAM_REGISTRY=

# Root working dir: every project/repo lives directly inside it. Mounted at /workspace for the agents.
# Production: a path on the target (e.g. /data/stacks/ai-team/workspace). Development: e.g. ~/github.
AI_TEAM_WORKSPACE_ROOT=/home/creator-base/github

# LLM providers switched on (names from configs/models.yaml), comma separated.
#   claude    = Claude Code CLI on your subscription (./deploy.sh runs the login)
#   omniroute = self-hosted OpenAI-compatible gateway
#   codex     = Codex CLI on a ChatGPT plan (./deploy.sh runs the device login)
#   anthropic = Anthropic API key (ANTHROPIC_API_KEY)
#   mock      = no LLM calls, deterministic fake agents (try the platform for free)
AI_TEAM_PROVIDERS=mock
# Routing chains (first enabled provider wins, next ones are fallbacks); defaults in configs/models.yaml
#AI_TEAM_ROUTE_DEFAULT=claude,omniroute
#AI_TEAM_ROUTE_ORCHESTRATOR=omniroute,claude

# Direct host:port on purpose: omniroute.local.internal goes through NPM, whose 90s proxy timeout cuts long LLM calls
AI_TEAM_OMNIROUTE_URL=http://192.168.100.10:10200/v1
AI_TEAM_OMNIROUTE_API_KEY=
ANTHROPIC_API_KEY=

# Dashboard port and number of agent replicas (production: 10800 = ai_team's port block on docker-vm)
AI_TEAM_PORT=8765
AI_TEAM_AGENTS=3
# Used in notification links (production: http://ai-team.local.internal, via Pi-hole + Nginx Proxy Manager)
AI_TEAM_PUBLIC_URL=http://localhost:8765

# Notifications: always stored on the dashboard; channels below switch on when filled in.
# Filters, retries and more channel types: configs/notifications.yaml.
AI_TEAM_NOTIFY_WEBHOOK_URL=
AI_TEAM_NOTIFY_NTFY_URL=
AI_TEAM_NOTIFY_NTFY_TOKEN=
AI_TEAM_NOTIFY_SLACK_WEBHOOK_URL=
AI_TEAM_NOTIFY_TELEGRAM_BOT_TOKEN=
AI_TEAM_NOTIFY_TELEGRAM_CHAT_ID=
AI_TEAM_NOTIFY_SMTP_HOST=
AI_TEAM_NOTIFY_SMTP_PORT=587
AI_TEAM_NOTIFY_SMTP_USER=
AI_TEAM_NOTIFY_SMTP_PASSWORD=
AI_TEAM_NOTIFY_EMAIL_FROM=
AI_TEAM_NOTIFY_EMAIL_TO=
AI_TEAM_NOTIFY_WHATSAPP_PHONE_NUMBER_ID=
AI_TEAM_NOTIFY_WHATSAPP_TOKEN=
AI_TEAM_NOTIFY_WHATSAPP_TO=

# Google Calendar scheduler: the calendar's "Secret address in iCal format" (comma separated for several).
# Events whose title contains the tag become tasks when they start (title = task, description = details).
AI_TEAM_GCAL_ICS_URLS=
AI_TEAM_GCAL_TAG=[ai]

# GitHub (pr_reviewer, scrum_master, PR watcher). true = ./deploy.sh logs gh in (device flow, or GH_TOKEN=...).
AI_TEAM_GITHUB_ENABLED=false
# owner/repo list: new PRs there become pr_review tasks (review-requested = only PRs requesting your review)
AI_TEAM_GITHUB_WATCH_REPOS=
AI_TEAM_GITHUB_WATCH_FILTER=review-requested
# let agents push feature branches and open PRs (never the default branch)
AI_TEAM_GIT_PUSH_ENABLED=false

# Agent toolbox switches (full access otherwise)
AI_TEAM_GIT_ENABLED=true
AI_TEAM_BROWSER_ENABLED=true
# SearXNG base URL for web_search (empty = DuckDuckGo HTML)
AI_TEAM_WEB_SEARCH_URL=
